#!/usr/bin/env bash
# QuadTwo (Q2) management CLI
# Usage:
#   q2                 # interactive menu
#   q2 start|stop|…    # direct command
#   quadtwo …          # same binary (symlink)
set -euo pipefail

SERVICE="${QUADTWO_SERVICE:-quadtwo}"
WEB_SERVICE="${SERVICE}-web"
DEMO_SERVICE="${QUADTWO_DEMO_SERVICE:-quadtwo-demo}"
DEMO_WEB_SERVICE="${DEMO_SERVICE}-web"
DIR="${QUADTWO_DIR:-/opt/quadtwo}"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
NC=$'\033[0m'

has_web() { systemctl list-unit-files "${WEB_SERVICE}.service" &>/dev/null; }

svc_start() {
  systemctl start "$SERVICE"
  has_web && systemctl start "$WEB_SERVICE" || true
  echo -e "${GREEN}Started${NC} ${SERVICE}${has_web:+ + ${WEB_SERVICE}}"
}

svc_stop() {
  has_web && systemctl stop "$WEB_SERVICE" || true
  systemctl stop "$SERVICE"
  echo -e "${YELLOW}Stopped${NC} ${SERVICE}${has_web:+ + ${WEB_SERVICE}}"
}

svc_restart() {
  systemctl restart "$SERVICE"
  has_web && systemctl restart "$WEB_SERVICE" || true
  echo -e "${GREEN}Restarted${NC} ${SERVICE}${has_web:+ + ${WEB_SERVICE}}"
}

svc_status() {
  systemctl status "$SERVICE" --no-pager || true
  if has_web; then
    echo
    systemctl status "$WEB_SERVICE" --no-pager || true
  fi
}

svc_logs() {
  if has_web; then
    journalctl -u "$SERVICE" -u "$WEB_SERVICE" -f -n 100
  else
    journalctl -u "$SERVICE" -f -n 100
  fi
}

env_file() { echo "$DIR/.env"; }
demo_env_file() { echo "$DIR/.env.demo"; }

env_get_from() {
  local file="$1" key="$2"
  [[ -f "$file" ]] || return 1
  grep -E "^${key}=" "$file" | tail -n1 | cut -d= -f2- | tr -d '\r'
}

env_get() {
  local key="$1"
  env_get_from "$(env_file)" "$key"
}

demo_env_get() {
  local key="$1"
  env_get_from "$(demo_env_file)" "$key"
}

set_env_key_in() {
  local file="$1" key="$2" value="$3" tmp
  [[ -f "$file" ]] || { echo "No env file at $file"; exit 1; }
  tmp="$(mktemp)"
  grep -v -E "^${key}=" "$file" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$file"
  chmod 600 "$file"
}

set_env_key() {
  set_env_key_in "$(env_file)" "$1" "$2"
}

set_demo_env_key() {
  set_env_key_in "$(demo_env_file)" "$1" "$2"
}

telegram_get_me() {
  local token="$1" proxy args=(-fsS --max-time 15)
  proxy="$(env_get TELEGRAM_PROXY 2>/dev/null || true)"
  [[ -n "$proxy" ]] && args+=(-x "$proxy")
  curl "${args[@]}" "https://api.telegram.org/bot${token}/getMe"
}

do_update() {
  bash <(curl -Ls https://raw.githubusercontent.com/Peymantia/quadtwo/main/install.sh) --update
}

do_env() {
  ${EDITOR:-nano} "$(env_file)"
}

do_set_token() {
  local TOKEN="${1:-}"
  local ENV_FILE ME_JSON BOT_USER BOT_NAME DOMAIN PATH_HOOK WEBHOOK_URL
  ENV_FILE="$(env_file)"
  [[ -f "$ENV_FILE" ]] || { echo "No .env at $ENV_FILE"; exit 1; }
  if [[ -z "$TOKEN" ]]; then
    read -r -p "New BOT_TOKEN from BotFather: " TOKEN
  fi
  TOKEN="$(echo "$TOKEN" | tr -d '[:space:]')"
  [[ -n "$TOKEN" ]] || { echo "BOT_TOKEN is required."; exit 1; }
  if [[ ! "$TOKEN" =~ ^[0-9]+:[A-Za-z0-9_-]+$ ]]; then
    echo "Token format looks invalid (expected 123456789:ABC...)."
    exit 1
  fi
  echo "Validating token with Telegram..."
  ME_JSON="$(telegram_get_me "$TOKEN")" || {
    echo "Telegram rejected this token (network or invalid token)."
    exit 1
  }
  BOT_USER="$(echo "$ME_JSON" | grep -o '"username":"[^"]*"' | head -1 | cut -d'"' -f4 || true)"
  BOT_NAME="$(echo "$ME_JSON" | grep -o '"first_name":"[^"]*"' | head -1 | cut -d'"' -f4 || true)"
  set_env_key BOT_TOKEN "$TOKEN"
  echo "BOT_TOKEN updated in $ENV_FILE"
  if [[ "$(env_get BOT_MODE)" == "webhook" ]]; then
    DOMAIN="$(env_get PUBLIC_DOMAIN)"
    PATH_HOOK="$(env_get TELEGRAM_WEBHOOK_PATH)"
    PATH_HOOK="${PATH_HOOK:-/telegram/webhook}"
    if [[ -n "$DOMAIN" ]]; then
      WEBHOOK_URL="https://${DOMAIN}${PATH_HOOK}"
      echo "Setting webhook: $WEBHOOK_URL"
      curl -fsS --max-time 15 \
        "https://api.telegram.org/bot${TOKEN}/setWebhook" \
        -d "url=${WEBHOOK_URL}" >/dev/null \
        || echo "Warning: setWebhook failed — check PUBLIC_DOMAIN and HTTPS."
    else
      echo "Warning: BOT_MODE=webhook but PUBLIC_DOMAIN is empty."
    fi
  fi
  echo "Restarting services..."
  svc_restart
  sleep 1
  if [[ -n "$BOT_USER" ]]; then
    echo "Done. New bot: @${BOT_USER}${BOT_NAME:+ ($BOT_NAME)}"
  else
    echo "Done. Service restarted."
  fi
  echo "Users must open the new bot and send /start."
}

do_set_admin() {
  local IDS="${1:-}" OLD_IDS ENV_FILE
  ENV_FILE="$(env_file)"
  [[ -f "$ENV_FILE" ]] || { echo "No .env at $ENV_FILE"; exit 1; }
  if [[ -z "$IDS" ]]; then
    echo "Current ADMIN_TELEGRAM_IDS: $(env_get ADMIN_TELEGRAM_IDS || echo '(empty)')"
    read -r -p "New admin Telegram numeric ID(s), comma-separated: " IDS
  fi
  IDS="$(echo "$IDS" | tr -d '[:space:]' | tr -d '@')"
  [[ -n "$IDS" ]] || { echo "Admin Telegram ID is required."; exit 1; }
  if [[ ! "$IDS" =~ ^[0-9]+(,[0-9]+)*$ ]]; then
    echo "Invalid ID list (expected numeric IDs like 123456789 or 111,222)."
    exit 1
  fi
  OLD_IDS="$(env_get ADMIN_TELEGRAM_IDS || true)"
  set_env_key ADMIN_TELEGRAM_IDS "$IDS"
  echo "ADMIN_TELEGRAM_IDS: ${OLD_IDS:-'(empty)'} → $IDS"
  echo "Syncing database roles..."
  (
    cd "$DIR"
    set -a
    # shellcheck disable=SC1091
    source "$ENV_FILE"
    set +a
    if [[ -x "$DIR/node_modules/.bin/tsx" ]]; then
      "$DIR/node_modules/.bin/tsx" apps/server/scripts/set-admin.ts "$IDS"
    elif command -v npx >/dev/null 2>&1; then
      npx --yes tsx apps/server/scripts/set-admin.ts "$IDS"
    else
      echo "Warning: tsx not found — .env updated but DB roles were not synced."
      echo "Run manually: cd $DIR && npx tsx apps/server/scripts/set-admin.ts $IDS"
    fi
  ) || {
    echo "Warning: DB sync failed — .env was still updated."
    echo "Fix DB with: cd $DIR && npx tsx apps/server/scripts/set-admin.ts $IDS"
  }
  echo "Restarting services..."
  svc_restart
  sleep 1
  echo "Done. New admin(s): $IDS"
  echo "Open the bot from the new Telegram account and send /start."
  echo "Old Telegram accounts are no longer control admins."
}

do_license_status() {
  echo -e "${BOLD}License status${NC}"
  echo "  DEMO_MODE:          $(env_get DEMO_MODE 2>/dev/null || echo '(empty)')"
  echo "  LICENSE_REQUIRE:    $(env_get LICENSE_REQUIRE 2>/dev/null || echo '(empty)')"
  echo "  LICENSE_KEY:        $( [[ -n "$(env_get LICENSE_KEY 2>/dev/null || true)" ]] && echo '(set)' || echo '(empty)' )"
  echo "  LICENSE_ADMIN_IDS:  $(env_get LICENSE_ADMIN_IDS 2>/dev/null || echo '(empty)')"
  echo "  LICENSE_DASH_HOST:  $(env_get LICENSE_DASH_HOST 2>/dev/null || echo '(empty)')"
  echo "  ADMIN_TELEGRAM_IDS: $(env_get ADMIN_TELEGRAM_IDS 2>/dev/null || echo '(empty)')"
  echo "  DASH_DOMAIN:        $(env_get DASH_DOMAIN 2>/dev/null || echo '(empty)')"
  if [[ -x "$DIR/node_modules/.bin/tsx" ]] || command -v npx >/dev/null 2>&1; then
    (
      cd "$DIR"
      set -a
      # shellcheck disable=SC1091
      source "$(env_file)" 2>/dev/null || true
      set +a
      if [[ -x "$DIR/node_modules/.bin/tsx" ]]; then
        "$DIR/node_modules/.bin/tsx" -e "import { getLicenseStatus } from './apps/server/src/services/license.ts'; const s=getLicenseStatus(); console.log('  verify:', JSON.stringify(s));"
      else
        npx --yes tsx -e "import { getLicenseStatus } from './apps/server/src/services/license.ts'; const s=getLicenseStatus(); console.log('  verify:', JSON.stringify(s));"
      fi
    ) 2>/dev/null || echo "  (runtime verify skipped — start the server to validate)"
  fi
}

demo_mode_on_file() {
  local file="$1" v
  v="$(env_get_from "$file" DEMO_MODE 2>/dev/null || true)"
  v="$(echo "$v" | tr '[:upper:]' '[:lower:]')"
  [[ "$v" == "1" || "$v" == "true" || "$v" == "yes" ]]
}

demo_mode_on() { demo_mode_on_file "$(env_file)"; }
demo_sidecar_on() { demo_mode_on_file "$(demo_env_file)"; }

has_demo_svc() { systemctl list-unit-files "${DEMO_SERVICE}.service" &>/dev/null; }

demo_svc_start() {
  systemctl start "$DEMO_SERVICE" 2>/dev/null || true
  systemctl start "$DEMO_WEB_SERVICE" 2>/dev/null || true
  echo -e "${GREEN}Started${NC} ${DEMO_SERVICE} + ${DEMO_WEB_SERVICE}"
}

demo_svc_stop() {
  systemctl stop "$DEMO_WEB_SERVICE" 2>/dev/null || true
  systemctl stop "$DEMO_SERVICE" 2>/dev/null || true
  echo -e "${YELLOW}Stopped${NC} ${DEMO_SERVICE} + ${DEMO_WEB_SERVICE}"
}

demo_svc_restart() {
  systemctl restart "$DEMO_SERVICE" 2>/dev/null || true
  systemctl restart "$DEMO_WEB_SERVICE" 2>/dev/null || true
  echo -e "${GREEN}Restarted${NC} ${DEMO_SERVICE} + ${DEMO_WEB_SERVICE}"
}

_print_bot_line() {
  local token="$1" me bot_user bot_name
  if [[ -z "$token" ]]; then
    echo "(no BOT_TOKEN)"
    return
  fi
  me="$(telegram_get_me "$token" 2>/dev/null || true)"
  if [[ -n "$me" ]]; then
    bot_user="$(echo "$me" | grep -o '"username":"[^"]*"' | head -1 | cut -d'"' -f4 || true)"
    bot_name="$(echo "$me" | grep -o '"first_name":"[^"]*"' | head -1 | cut -d'"' -f4 || true)"
    if [[ -n "$bot_user" ]]; then
      echo "@${bot_user}${bot_name:+ ($bot_name)}"
    else
      echo "(token set — could not parse getMe)"
    fi
  else
    echo "(token set — Telegram unreachable / invalid)"
  fi
}

do_demo_status() {
  local main_demo demo_file
  demo_file="$(demo_env_file)"
  echo -e "${BOLD}Demo showcase status${NC}"
  echo
  echo -e "${CYAN}── Production (.env) ──${NC}"
  main_demo=0
  if demo_mode_on; then
    main_demo=1
    echo -e "  DEMO_MODE: ${RED}ON — DANGER${NC}  (turn off with: q2 demo fix-main)"
  else
    echo -e "  DEMO_MODE: ${GREEN}off${NC}  (good)"
  fi
  echo "  Dash:      $(env_get DASH_DOMAIN 2>/dev/null || echo '(empty)')"
  echo "  Bot:       $(_print_bot_line "$(env_get BOT_TOKEN 2>/dev/null || true)")"
  echo
  echo -e "${CYAN}── Demo sidecar (.env.demo) ──${NC}"
  if [[ -f "$demo_file" ]]; then
    if demo_sidecar_on; then
      echo -e "  DEMO_MODE: ${GREEN}ON${NC}"
    else
      echo -e "  DEMO_MODE: ${YELLOW}off${NC} in .env.demo"
    fi
    echo "  Dash:      $(demo_env_get DASH_DOMAIN 2>/dev/null || echo '(empty)')"
    echo "  API port:  $(demo_env_get PORT 2>/dev/null || echo '(empty)')"
    echo "  Web port:  $(demo_env_get DEMO_WEB_PORT 2>/dev/null || echo '(empty)')"
    echo "  Database:  $(demo_env_get DATABASE_URL 2>/dev/null || echo '(empty)')"
    echo "  XUI_*:     $( [[ -n "$(demo_env_get XUI_BASE_URL 2>/dev/null || true)" ]] && echo "${RED}SET — should be empty${NC}" || echo "${GREEN}unset (isolated)${NC}" )"
    echo "  Bot:       $(_print_bot_line "$(demo_env_get BOT_TOKEN 2>/dev/null || true)")"
    echo "  Admins:    $(demo_env_get ADMIN_TELEGRAM_IDS 2>/dev/null || echo '(empty)')"
    if has_demo_svc; then
      echo -n "  Services:  "
      systemctl is-active --quiet "$DEMO_SERVICE" && echo -n "${GREEN}${DEMO_SERVICE} active${NC}" || echo -n "${YELLOW}${DEMO_SERVICE} inactive${NC}"
      echo -n " · "
      systemctl is-active --quiet "$DEMO_WEB_SERVICE" && echo -e "${GREEN}${DEMO_WEB_SERVICE} active${NC}" || echo -e "${YELLOW}${DEMO_WEB_SERVICE} inactive${NC}"
    else
      echo "  Services:  (not installed — run q2 demo setup)"
    fi
  else
    echo -e "  ${DIM}Not set up yet. Run: q2 demo setup${NC}"
  fi
  echo
  if [[ "$main_demo" -eq 1 ]]; then
    echo -e "${RED}Production has DEMO_MODE=true — this merges demo into the live shop.${NC}"
    echo -e "${RED}Run: q2 demo fix-main${NC}"
  fi
}

do_demo_fix_main() {
  local ENV_FILE
  ENV_FILE="$(env_file)"
  [[ -f "$ENV_FILE" ]] || { echo "No .env at $ENV_FILE"; exit 1; }
  if ! demo_mode_on; then
    echo "Production DEMO_MODE is already off."
    return 0
  fi
  set_env_key DEMO_MODE "false"
  echo -e "Production DEMO_MODE → ${GREEN}false${NC}"
  echo "Restarting production services..."
  svc_restart
  sleep 1
  echo "Done. Live shop is no longer in demo mode."
}

write_demo_systemd() {
  local api_port="$1" web_port="$2"
  cat > "/etc/systemd/system/${DEMO_SERVICE}.service" <<EOF
[Unit]
Description=Quadtwo Demo Bot (isolated showcase)
After=network.target

[Service]
Type=simple
WorkingDirectory=${DIR}
EnvironmentFile=${DIR}/.env.demo
ExecStart=/usr/bin/node ${DIR}/apps/server/dist/index.js
Restart=always
RestartSec=5
User=root
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
EOF

  cat > "/etc/systemd/system/${DEMO_WEB_SERVICE}.service" <<EOF
[Unit]
Description=Quadtwo Demo Web Dashboard
After=network.target ${DEMO_SERVICE}.service

[Service]
Type=simple
WorkingDirectory=${DIR}/apps/web
EnvironmentFile=${DIR}/.env.demo
Environment=PORT=${web_port}
Environment=NODE_ENV=production
ExecStart=${DIR}/node_modules/.bin/next start -p ${web_port}
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
EOF

  systemctl daemon-reload
  systemctl enable "$DEMO_SERVICE" "$DEMO_WEB_SERVICE"
}

write_demo_nginx() {
  local host="$1" api_port="$2" web_port="$3" conf
  conf="/etc/nginx/sites-available/${host}"
  if ! command -v nginx >/dev/null 2>&1; then
    echo -e "${YELLOW}nginx not found — skip site config. Point ${host} to :${web_port} yourself.${NC}"
    return 0
  fi
  cat > "$conf" <<EOF
# QuadTwo demo showcase — isolated from production
upstream quadtwo_demo_api {
    server 127.0.0.1:${api_port};
}
upstream quadtwo_demo_web {
    server 127.0.0.1:${web_port};
}
server {
    listen 80;
    listen [::]:80;
    server_name ${host};

    client_max_body_size 20m;

    location /api/ {
        proxy_pass http://quadtwo_demo_api;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
    location /health {
        proxy_pass http://quadtwo_demo_api;
        proxy_set_header Host \$host;
    }
    location /telegram/ {
        proxy_pass http://quadtwo_demo_api;
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
    location /_next/static/ {
        proxy_pass http://quadtwo_demo_web;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location / {
        proxy_pass http://quadtwo_demo_web;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
}
EOF
  ln -sfn "$conf" "/etc/nginx/sites-enabled/${host}"
  if nginx -t; then
    systemctl reload nginx
    echo -e "Nginx site → ${GREEN}${host}${NC}"
  else
    echo -e "${RED}nginx -t failed — fix ${conf}${NC}"
  fi
}

do_demo_setup() {
  local ENV_MAIN DEMO_FILE HOST TOKEN IDS API_PORT WEB_PORT DB_PATH ans prod_dash suggest
  ENV_MAIN="$(env_file)"
  DEMO_FILE="$(demo_env_file)"
  [[ -f "$ENV_MAIN" ]] || { echo "No production .env at $ENV_MAIN — install QuadTwo first."; exit 1; }

  echo -e "${BOLD}Demo showcase setup (same VPS, isolated stack)${NC}"
  echo
  echo "This creates a SECOND stack beside production:"
  echo "  · .env.demo + data/demo.db  (fake DB — no 3x-ui credentials)"
  echo "  · systemd ${DEMO_SERVICE} / ${DEMO_WEB_SERVICE}"
  echo "  · nginx for your demo subdomain"
  echo "  · production DEMO_MODE forced OFF"
  echo

  if demo_mode_on; then
    echo -e "${YELLOW}Production currently has DEMO_MODE=true — will turn it OFF.${NC}"
  fi

  prod_dash="$(env_get DASH_DOMAIN 2>/dev/null || true)"
  prod_dash="${prod_dash:-dash.example.com}"
  # Suggest demo.<apex> if prod is dash.x.com
  suggest="demo.${prod_dash#*.}"
  if [[ "$prod_dash" != *.* ]]; then suggest="demo.example.com"; fi

  read -r -p "Demo subdomain [${suggest}]: " HOST || true
  HOST="$(echo "${HOST:-$suggest}" | tr -d '[:space:]' | sed 's|^https\?://||;s|/$||')"
  [[ -n "$HOST" ]] || { echo "Subdomain required."; exit 1; }

  read -r -p "Demo BOT_TOKEN (BotFather — separate bot): " TOKEN || true
  TOKEN="$(echo "${TOKEN:-}" | tr -d '[:space:]')"
  [[ -n "$TOKEN" ]] || { echo "BOT_TOKEN required."; exit 1; }
  if [[ ! "$TOKEN" =~ ^[0-9]+:[A-Za-z0-9_-]+$ ]]; then
    echo "Token format looks invalid."; exit 1
  fi
  echo "Validating token..."
  telegram_get_me "$TOKEN" >/dev/null || { echo "Telegram rejected this token."; exit 1; }

  local def_admin
  def_admin="$(env_get ADMIN_TELEGRAM_IDS 2>/dev/null || true)"
  read -r -p "Demo admin Telegram ID(s) [${def_admin:-required}]: " IDS || true
  IDS="$(echo "${IDS:-$def_admin}" | tr -d '[:space:]' | tr -d '@')"
  [[ -n "$IDS" ]] || { echo "Admin ID required."; exit 1; }
  if [[ ! "$IDS" =~ ^[0-9]+(,[0-9]+)*$ ]]; then
    echo "Invalid ID list."; exit 1
  fi

  read -r -p "Demo API port [4010]: " API_PORT || true
  API_PORT="${API_PORT:-4010}"
  read -r -p "Demo web port [3010]: " WEB_PORT || true
  WEB_PORT="${WEB_PORT:-3010}"
  if [[ ! "$API_PORT" =~ ^[0-9]+$ ]] || [[ ! "$WEB_PORT" =~ ^[0-9]+$ ]]; then
    echo "Ports must be numeric."; exit 1
  fi

  echo
  echo "Summary:"
  echo "  Host:     https://${HOST}"
  echo "  API:      127.0.0.1:${API_PORT}"
  echo "  Web:      127.0.0.1:${WEB_PORT}"
  echo "  DB:       ${DIR}/data/demo.db"
  echo "  Panel:    NONE (isolated)"
  read -r -p "Apply? [y/N]: " ans || true
  case "${ans:-}" in y|Y|yes|YES) ;; *) echo "Cancelled."; return 0 ;; esac

  mkdir -p "${DIR}/data"
  DB_PATH="file:${DIR}/data/demo.db"

  cat > "$DEMO_FILE" <<EOF
NODE_ENV=production
PORT=${API_PORT}
DEMO_WEB_PORT=${WEB_PORT}
DATABASE_URL=${DB_PATH}

DEMO_MODE=true
DEMO_ALLOW_PROD=1
BOT_TOKEN=${TOKEN}
BOT_MODE=polling
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
ADMIN_TELEGRAM_IDS=${IDS}

# Intentionally empty — demo must never talk to 3x-ui
# XUI_BASE_URL=
# XUI_API_TOKEN=

PUBLIC_DOMAIN=${HOST}
DASH_DOMAIN=${HOST}
NEXT_PUBLIC_API_URL=https://${HOST}
NEXT_PUBLIC_APP_URL=https://${HOST}
CORS_ORIGINS=https://${HOST}
EOF
  chmod 600 "$DEMO_FILE"
  echo "Wrote $DEMO_FILE"

  # Keep production clean
  if demo_mode_on; then
    set_env_key DEMO_MODE "false"
    echo -e "Production DEMO_MODE → ${GREEN}false${NC}"
    svc_restart
  fi

  echo "Preparing fake demo database..."
  (
    cd "$DIR"
    set -a
    # shellcheck disable=SC1091
    source "$DEMO_FILE"
    set +a
    DATABASE_URL="$DB_PATH" npm run db:push -w @quadtwo/server
  ) || {
    echo "db:push failed — check prisma."
    exit 1
  }

  # Seed prices into demo DB by briefly starting seed via node
  (
    cd "$DIR"
    set -a
    # shellcheck disable=SC1091
    source "$DEMO_FILE"
    set +a
    if [[ -x "$DIR/node_modules/.bin/tsx" ]]; then
      "$DIR/node_modules/.bin/tsx" -e "import { seedIfNeeded } from './apps/server/src/services/seed.ts'; await seedIfNeeded(); console.log('demo seed ok');"
    else
      npx --yes tsx -e "import { seedIfNeeded } from './apps/server/src/services/seed.ts'; await seedIfNeeded(); console.log('demo seed ok');"
    fi
  ) || echo "Warning: price seed skipped (server start will seed)."

  (
    cd "$DIR"
    set -a
    # shellcheck disable=SC1091
    source "$DEMO_FILE"
    set +a
    if [[ -x "$DIR/node_modules/.bin/tsx" ]]; then
      "$DIR/node_modules/.bin/tsx" apps/server/scripts/set-admin.ts "$IDS"
    else
      npx --yes tsx apps/server/scripts/set-admin.ts "$IDS"
    fi
  ) || echo "Warning: demo admin sync failed."

  write_demo_systemd "$API_PORT" "$WEB_PORT"
  write_demo_nginx "$HOST" "$API_PORT" "$WEB_PORT"
  demo_svc_restart
  sleep 2

  echo
  do_demo_status
  echo
  echo -e "${GREEN}Done.${NC}"
  echo "1) DNS: A record ${HOST} → this server IP (Cloudflare orange OK)"
  echo "2) Open bot → /start — sample fake accounts appear in «سرویس‌های من»"
  echo "3) Dash: https://${HOST}"
  echo "4) Nothing in demo talks to your Sanai panel."
}

do_demo_disable() {
  local ans
  echo "This stops the demo sidecar services (production untouched)."
  if [[ -f "$(demo_env_file)" ]]; then
    read -r -p "Also set DEMO_MODE=false in .env.demo? [y/N]: " ans || true
    case "${ans:-}" in
      y|Y|yes|YES) set_demo_env_key DEMO_MODE "false"; echo "DEMO_MODE=false in .env.demo" ;;
    esac
  fi
  if has_demo_svc; then
    demo_svc_stop
  fi
  # Legacy: main .env DEMO_MODE
  if demo_mode_on; then
    echo "Also clearing production DEMO_MODE..."
    do_demo_fix_main
  fi
  echo "Done."
}

do_demo_uninstall() {
  local ans host purge
  echo -e "${BOLD}Uninstall demo showcase${NC}"
  echo "Removes: systemd ${DEMO_SERVICE}/${DEMO_WEB_SERVICE}, nginx site,"
  echo "         .env.demo, data/demo.db — production shop stays."
  echo
  read -r -p "Uninstall demo completely? [y/N]: " ans || true
  case "${ans:-}" in y|Y|yes|YES) ;; *) echo "Cancelled."; return 0 ;; esac

  demo_svc_stop 2>/dev/null || true
  systemctl disable "$DEMO_SERVICE" "$DEMO_WEB_SERVICE" 2>/dev/null || true
  rm -f "/etc/systemd/system/${DEMO_SERVICE}.service" "/etc/systemd/system/${DEMO_WEB_SERVICE}.service"
  systemctl daemon-reload

  host="$(demo_env_get DASH_DOMAIN 2>/dev/null || true)"
  if [[ -n "$host" ]]; then
    rm -f "/etc/nginx/sites-enabled/${host}" "/etc/nginx/sites-available/${host}"
    nginx -t 2>/dev/null && systemctl reload nginx || true
    echo "Nginx site removed: ${host}"
  fi

  rm -f "$(demo_env_file)"
  rm -f "${DIR}/data/demo.db" "${DIR}/data/demo.db-journal" 2>/dev/null || true
  echo "Removed .env.demo and data/demo.db (if present)."

  if [[ -f "$(env_file)" ]] && demo_mode_on; then
    set_env_key DEMO_MODE "false"
    echo -e "Production DEMO_MODE → ${GREEN}false${NC}"
    svc_restart
  fi
  echo -e "${GREEN}Demo uninstall complete.${NC} Customer shop is demo-free."
}

# Prepare / install production only — no showcase stack (for paying customers).
do_install_without_demo() {
  local ans host
  echo -e "${BOLD}Install without demo${NC} ${DIM}(customer / production only)${NC}"
  echo
  echo "This path is for buyers who should NOT get the demo showcase:"
  echo "  · DEMO_MODE=false on production"
  echo "  · remove any quadtwo-demo services / .env.demo / demo.db"
  echo "  · if QuadTwo is missing, run the normal installer"
  echo

  if [[ ! -f "$(env_file)" ]]; then
    echo "No production install at ${DIR}."
    read -r -p "Run fresh install.sh now (no demo)? [y/N]: " ans || true
    case "${ans:-}" in y|Y|yes|YES) ;; *) echo "Cancelled."; return 0 ;; esac
    if [[ -f "${DIR}/scripts/install.sh" ]]; then
      bash "${DIR}/scripts/install.sh"
    elif [[ -f "${DIR}/install.sh" ]]; then
      bash "${DIR}/install.sh"
    else
      bash <(curl -Ls https://raw.githubusercontent.com/Peymantia/quadtwo/main/install.sh)
    fi
  else
    echo "Production install found at ${DIR}."
    read -r -p "Strip demo + force DEMO_MODE=false? [y/N]: " ans || true
    case "${ans:-}" in y|Y|yes|YES) ;; *) echo "Cancelled."; return 0 ;; esac
  fi

  if [[ -f "$(env_file)" ]]; then
    set_env_key DEMO_MODE "false"
    echo -e "DEMO_MODE → ${GREEN}false${NC}"
  fi

  if has_demo_svc || [[ -f "$(demo_env_file)" ]]; then
    echo "Removing demo sidecar…"
    demo_svc_stop 2>/dev/null || true
    systemctl disable "$DEMO_SERVICE" "$DEMO_WEB_SERVICE" 2>/dev/null || true
    rm -f "/etc/systemd/system/${DEMO_SERVICE}.service" "/etc/systemd/system/${DEMO_WEB_SERVICE}.service"
    systemctl daemon-reload 2>/dev/null || true
    host="$(demo_env_get DASH_DOMAIN 2>/dev/null || true)"
    if [[ -n "${host:-}" ]]; then
      rm -f "/etc/nginx/sites-enabled/${host}" "/etc/nginx/sites-available/${host}"
      nginx -t 2>/dev/null && systemctl reload nginx || true
    fi
    rm -f "$(demo_env_file)"
    rm -f "${DIR}/data/demo.db" "${DIR}/data/demo.db-journal" 2>/dev/null || true
    echo "Demo stack removed."
  else
    echo "No demo sidecar present."
  fi

  if [[ -f "$(env_file)" ]]; then
    svc_restart 2>/dev/null || true
  fi
  echo
  echo -e "${GREEN}Done.${NC} Customer install is without demo."
  echo "  Activate license: q2 activate"
  echo "  Demo later (your VPS only): q2 demo setup"
}

demo_menu() {
  local choice
  while true; do
    clear 2>/dev/null || true
    cat <<EOF
${BOLD}${CYAN}╔══════════════════════════╗
║   Demo showcase          ║
╚══════════════════════════╝${NC}
${DIM}Isolated stack on same VPS · fake DB · no 3x-ui${NC}

EOF
    do_demo_status
    cat <<EOF

  ${GREEN}1${NC}) status
  ${GREEN}2${NC}) setup     ${DIM}(subdomain, ports, token, fake DB — one wizard)${NC}
  ${GREEN}3${NC}) start / restart demo services
  ${GREEN}4${NC}) stop demo services
  ${GREEN}5${NC}) fix-main  ${DIM}(force DEMO_MODE=false on production)${NC}
  ${GREEN}6${NC}) disable   ${DIM}(stop demo + clear flags)${NC}
  ${GREEN}7${NC}) uninstall ${DIM}(remove demo systemd/nginx + .env.demo + demo.db)${NC}
  ${YELLOW}0${NC}) back

EOF
    read -r -p "Select [0-7]: " choice || true
    case "${choice:-}" in
      1) do_demo_status; pause ;;
      2) do_demo_setup; pause ;;
      3) demo_svc_restart; pause ;;
      4) demo_svc_stop; pause ;;
      5) do_demo_fix_main; pause ;;
      6) do_demo_disable; pause ;;
      7) do_demo_uninstall; pause ;;
      0|b|B|back) return 0 ;;
      *)
        echo "Invalid option."
        pause
        ;;
    esac
  done
}

do_demo() {
  local sub="${1:-}"
  shift || true
  case "${sub}" in
    ""|menu) demo_menu ;;
    status|st) do_demo_status ;;
    setup|enable|on|true) do_demo_setup ;;
    start|restart) demo_svc_restart ;;
    stop) demo_svc_stop ;;
    fix-main|fixmain) do_demo_fix_main ;;
    disable|off|false) do_demo_disable ;;
    uninstall|remove) do_demo_uninstall ;;
    help|-h|--help)
      cat <<EOF
${BOLD}q2 demo${NC} — isolated demo stack on the same VPS

  q2 demo              Interactive menu
  q2 demo status       Production + demo sidecar status
  q2 demo setup        Wizard: subdomain, ports, bot token, fake DB
  q2 demo start|stop   Demo systemd services
  q2 demo fix-main     Force DEMO_MODE=false on production .env
  q2 demo disable      Stop demo + clear flags
  q2 demo uninstall    Remove demo systemd/nginx units

Creates:
  ${DIR}/.env.demo
  ${DIR}/data/demo.db          # fake DB — no Sanai panel
  systemd ${DEMO_SERVICE} + ${DEMO_WEB_SERVICE}
  nginx site for your demo subdomain
EOF
      ;;
    *)
      echo "Unknown demo subcommand: $sub"
      echo "Try: q2 demo help"
      exit 1
      ;;
  esac
}

do_activate() {
  local KEY="${1:-}" ENV_FILE HOST ADMINS PARSED
  ENV_FILE="$(env_file)"
  [[ -f "$ENV_FILE" ]] || { echo "No .env at $ENV_FILE"; exit 1; }
  if [[ -z "$KEY" ]]; then
    echo "Paste the license key from the seller (Q2.1.…):"
    read -r KEY
  fi
  KEY="$(echo "$KEY" | tr -d '[:space:]')"
  [[ -n "$KEY" ]] || { echo "LICENSE_KEY is required."; exit 1; }
  if [[ ! "$KEY" =~ ^Q2\.1\. ]]; then
    echo "Key format looks invalid (expected Q2.1.…)."
    exit 1
  fi

  echo "Validating license…"
  PARSED="$(
    cd "$DIR"
    set -a
    # shellcheck disable=SC1091
    source "$ENV_FILE" 2>/dev/null || true
    set +a
    if [[ -x "$DIR/node_modules/.bin/tsx" ]]; then
      "$DIR/node_modules/.bin/tsx" -e "
        import { parseLicenseKey } from './apps/server/src/services/license.ts';
        const r = parseLicenseKey(process.argv[1]);
        if (!r.ok) { console.error(r.reason); process.exit(2); }
        console.log(r.payload.admins + '|' + r.payload.host);
      " "$KEY"
    else
      npx --yes tsx -e "
        import { parseLicenseKey } from './apps/server/src/services/license.ts';
        const r = parseLicenseKey(process.argv[1]);
        if (!r.ok) { console.error(r.reason); process.exit(2); }
        console.log(r.payload.admins + '|' + r.payload.host);
      " "$KEY"
    fi
  )" || {
    echo "License validation failed."
    exit 1
  }
  ADMINS="${PARSED%%|*}"
  HOST="${PARSED#*|}"
  [[ -n "$ADMINS" && -n "$HOST" ]] || { echo "Could not decode license payload."; exit 1; }

  set_env_key LICENSE_KEY "$KEY"
  set_env_key LICENSE_ADMIN_IDS "$ADMINS"
  set_env_key LICENSE_DASH_HOST "$HOST"
  set_env_key LICENSE_REQUIRE "1"
  set_env_key ADMIN_TELEGRAM_IDS "$ADMINS"
  # Align dashboard domain if empty
  if [[ -z "$(env_get DASH_DOMAIN 2>/dev/null || true)" ]]; then
    set_env_key DASH_DOMAIN "$HOST"
  fi
  echo "License bound:"
  echo "  admins: $ADMINS"
  echo "  host:   $HOST"
  echo "Syncing DB admin roles…"
  (
    cd "$DIR"
    set -a
    # shellcheck disable=SC1091
    source "$ENV_FILE"
    set +a
    if [[ -x "$DIR/node_modules/.bin/tsx" ]]; then
      "$DIR/node_modules/.bin/tsx" apps/server/scripts/set-admin.ts "$ADMINS"
    else
      npx --yes tsx apps/server/scripts/set-admin.ts "$ADMINS"
    fi
  ) || echo "Warning: DB sync failed — .env was still updated."
  echo "Restarting…"
  svc_restart
  sleep 1
  echo "Done. Licensed admin(s) should /start the bot."
}

print_usage() {
  cat <<EOF
${BOLD}QuadTwo (Q2)${NC} — manage bot & dashboard

Usage:
  q2                 Interactive menu
  q2 start           Start services
  q2 stop            Stop services
  q2 restart         Restart services
  q2 update          Pull & rebuild from GitHub
  q2 status          Service status
  q2 logs            Follow journal logs
  q2 env             Edit .env
  q2 set-token [TOKEN]
  q2 set-admin [ID,...]
  q2 activate [KEY]  Bind license (Telegram admin + dash host)
  q2 license         Show license status
  q2 demo            Demo showcase (isolated stack / setup wizard)
  q2 demo status|setup|fix-main|start|stop|uninstall
  q2 install-without-demo   Customer install — strip demo / DEMO_MODE=off
  q2 demo uninstall         Remove demo sidecar completely

Also available as: ${CYAN}quadtwo${NC}
EOF
}

run_cmd() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    start) svc_start ;;
    stop) svc_stop ;;
    restart) svc_restart ;;
    update) do_update ;;
    status) svc_status ;;
    logs) svc_logs ;;
    env) do_env ;;
    set-token|settoken) do_set_token "${1:-}" ;;
    set-admin|setadmin) do_set_admin "${1:-}" ;;
    activate) do_activate "${1:-}" ;;
    license|lic) do_license_status ;;
    demo) do_demo "$@" ;;
    install-without-demo|install_without_demo|customer-install)
      do_install_without_demo
      ;;
    help|-h|--help) print_usage ;;
    "") return 1 ;;
    *)
      echo "Unknown command: $cmd"
      print_usage
      exit 1
      ;;
  esac
}

pause() {
  echo
  read -r -p "Press Enter to continue…" _ || true
}

show_menu() {
  clear 2>/dev/null || true
  cat <<EOF
${BOLD}${CYAN}╔══════════════════════════╗
║   QuadTwo  ·  Q2         ║
╚══════════════════════════╝${NC}
${DIM}dir: ${DIR}${NC}

  ${GREEN}1${NC}) start
  ${GREEN}2${NC}) stop
  ${GREEN}3${NC}) restart
  ${GREEN}4${NC}) update
  ${GREEN}5${NC}) status
  ${GREEN}6${NC}) logs
  ${GREEN}7${NC}) env
  ${GREEN}8${NC}) set-token  ${DIM}[TOKEN]${NC}
  ${GREEN}9${NC}) set-admin  ${DIM}[ID,...]${NC}
  ${GREEN}a${NC}) activate   ${DIM}[license key]${NC}
  ${GREEN}l${NC}) license status
  ${GREEN}d${NC}) demo        ${DIM}(isolated showcase — your VPS)${NC}
  ${GREEN}i${NC}) install without demo  ${DIM}(customer / production only)${NC}
  ${GREEN}u${NC}) demo uninstall        ${DIM}(remove demo completely)${NC}
  ${YELLOW}0${NC}) exit

EOF
  read -r -p "Select [0-9/a/l/d/i/u]: " choice || true
  case "${choice:-}" in
    1) run_cmd start; pause ;;
    2) run_cmd stop; pause ;;
    3) run_cmd restart; pause ;;
    4) run_cmd update; pause ;;
    5) run_cmd status; pause ;;
    6)
      echo -e "${DIM}Ctrl+C to stop following logs${NC}"
      run_cmd logs || true
      pause
      ;;
    7) run_cmd env; pause ;;
    8)
      read -r -p "BOT_TOKEN (Enter to prompt later): " tok || true
      run_cmd set-token "${tok:-}"
      pause
      ;;
    9)
      read -r -p "Admin ID(s) comma-separated (Enter to prompt): " ids || true
      run_cmd set-admin "${ids:-}"
      pause
      ;;
    a|A)
      read -r -p "License key (Enter to paste next): " key || true
      run_cmd activate "${key:-}"
      pause
      ;;
    l|L) run_cmd license; pause ;;
    d|D) run_cmd demo ;;
    i|I)
      do_install_without_demo
      pause
      ;;
    u|U)
      do_demo_uninstall
      pause
      ;;
    0|q|Q|exit) echo "Bye."; exit 0 ;;
    *)
      echo "Invalid option."
      pause
      ;;
  esac
}

main() {
  if [[ $# -eq 0 ]]; then
    while true; do
      show_menu
    done
  else
    run_cmd "$@"
  fi
}

main "$@"
