generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  partner
  /// عمده‌فروش — فقط پلن‌های ثابت تعریف‌شده توسط ادمین
  wholesale
  /// همکار ویژه (قیمت/خرید شبیه همکار با نرخ عمده سابق)
  reseller
  admin
}

enum OrderStatus {
  pending_payment
  awaiting_review
  paid
  /// Serverless: paid and waiting for admin to paste/send subscription URL
  awaiting_delivery
  provisioning
  completed
  rejected
  cancelled
}

enum PaymentMethod {
  card_to_card
  wallet
  online
  crypto
}

enum OrderKind {
  new
  renew
  rotate_sub
  rotate_uuid
  wallet_charge
  /// Add calendar days to an existing subscription (order.months = days)
  add_days
  /// Add GB to an existing volume subscription (order.trafficGb = added GB)
  add_gb
}

enum WalletTxType {
  charge
  purchase
  refund
  adjust
}

enum SubscriptionStatus {
  active
  expired
  disabled
}

enum TenantStatus {
  active
  suspended
}

/// SaaS white-label customer (one Telegram bot + branding + panels)
model Tenant {
  id               String       @id @default(cuid())
  /// Subdomain / path slug e.g. acme → acme.dash.example.com
  slug             String       @unique
  name             String
  /// Encrypted or plain bot token (same trust model as PanelServer.apiToken in v1)
  botToken         String
  botUsername      String?
  brandName        String       @default("")
  logoUrl          String?
  welcomeText      String?
  supportUsername  String?
  /// Platform owner for this tenant (Telegram id of their admin)
  ownerTelegramId  BigInt?
  /// true = the original install / superadmin host tenant
  isPlatform       Boolean      @default(false)
  status           TenantStatus @default(active)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  users            User[]
  settings         Setting[]
  priceCells       PriceCell[]
  panelServers     PanelServer[]
  orders           Order[]
  subscriptions    Subscription[]
  discountCodes    DiscountCode[]
  buyDrafts        BuyDraft[]
  partnerRequests  PartnerRequest[]
  agentRenames     AgentRenameRequest[]
  plans            Plan[]
  accountArchives  AccountArchive[]
  auditLogs        AuditLog[]
  agentPriceOverrides AgentPriceOverride[]
}

model User {
  id            String    @id @default(cuid())
  tenantId      String
  telegramId    BigInt
  username      String?
  firstName     String?
  lastName      String?
  role          UserRole  @default(user)
  /// Display name of reseller/admin agent (required for dedicated panel group)
  agentName     String?
  panelGroup    String?
  /// When user claimed the free 1-day / 250MB test account
  testClaimedAt DateTime?
  /// When user accepted bot/web terms of use (قوانین)
  termsAcceptedAt DateTime?
  /// scrypt hash for web dashboard password login
  passwordHash  String?
  passwordSetAt DateTime?
  /// Agent may create/manage discount codes (admin always can). Default on.
  discountCodesAllowed Boolean @default(true)
  /// Max % this agent may put on codes they create (1–100). Admin ignores (always 100). Default 30.
  discountMaxPercent   Int     @default(30)
  /// When false (default), checkout uses panel default pricing; saved overrides are kept but ignored.
  useCustomPricing Boolean @default(false)
  /// Platform superadmin (only on platform tenant)
  isSuperAdmin  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wallet         Wallet?
  orders         Order[]
  subscriptions  Subscription[]
  partnerRequest PartnerRequest?
  agentRenames   AgentRenameRequest[]
  loginOtps      LoginOtp[]
  webAuthnCreds  WebAuthnCredential[]
  discountCodes  DiscountCode[]
  priceOverrides AgentPriceOverride[]

  @@unique([tenantId, telegramId])
  @@index([tenantId])
  @@index([telegramId])
}

/// Per-user/agent rate overrides for one service category (data, national, unlimited, …)
model AgentPriceOverride {
  id                 String   @id @default(cuid())
  tenantId           String
  userId             String
  /// Service category key this override applies to (e.g. data, national, unlimited)
  category           String   @default("data")
  perGb              Int?
  perMonth           Int?
  unlimitedPerMonth  Int?
  /// Multiply matrix cell price (100 = no change)
  partnerPricePercent Int     @default(100)
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([tenantId])
  @@index([userId])
}

/// WebAuthn / Passkey credentials for dashboard biometric login
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  /// base64url credential id
  credentialId String    @unique
  /// base64url public key
  publicKey    String
  counter      BigInt    @default(0)
  /// JSON array of transports e.g. ["internal","hybrid"]
  transports   String?
  deviceType   String?
  backedUp     Boolean   @default(false)
  label        String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time codes for dash login (Telegram delivery)
model LoginOtp {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  txs       WalletTransaction[]
}

model WalletTransaction {
  id            String       @id @default(cuid())
  walletId      String
  type          WalletTxType
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  note          String?
  createdAt     DateTime     @default(now())
  wallet        Wallet       @relation(fields: [walletId], references: [id])
}

model Plan {
  id            String   @id @default(cuid())
  tenantId      String
  title         String
  trafficGb     Int?
  durationDays  Int
  priceUser     Int
  pricePartner  Int
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@index([tenantId])
}

/// Manual price matrix: trafficGb null = unlimited
model PriceCell {
  id             String  @id @default(cuid())
  tenantId       String
  title          String?
  /// data | national | unlimited
  category       String  @default("data")
  trafficGb      Int?
  months         Int
  priceUser      Int
  pricePartner   Int
  priceWholesale Int     @default(0)
  /// Price for wholesale role (عمده‌فروش) — used for category=wholesale fixed plans
  priceReseller   Int     @default(0)
  /// Max simultaneous IPs for this plan (0 = use system default). Used by عمده‌فروش fixed plans.
  limitIp        Int     @default(0)
  isGolden       Boolean @default(false)
  active         Boolean @default(true)
  sortOrder      Int     @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category, months])
}

model PanelServer {
  id          String   @id @default(cuid())
  tenantId    String
  /// Display name e.g. "سرور اصلی" / "نت ملی"
  name        String
  baseUrl     String
  /// API bearer token (plain in v1, same trust model as .env)
  apiToken    String
  /// Comma / space inbound ids, e.g. "1,2,3"
  inboundIds  String   @default("1")
  /// Optional subscription URL base override (like XUI_SUB_BASE)
  subBase     String?
  /// JSON array of categories this panel serves: ["data","national","unlimited"]
  categories  String   @default("[\"data\",\"unlimited\"]")
  active      Boolean  @default(true)
  sellEnabled Boolean  @default(true)
  weight      Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  orders        Order[]

  @@index([tenantId])
}

model Order {
  id              String        @id @default(cuid())
  tenantId        String
  userId          String
  planId          String?
  kind            OrderKind     @default(new)
  trafficGb       Float?
  months          Int           @default(1)
  /// Default 0 only so schema push can re-add the column after accidental drop; app always sets real price.
  price           Int           @default(0)
  status          OrderStatus   @default(pending_payment)
  paymentMethod   PaymentMethod @default(card_to_card)
  receiptFileId   String?
  receiptText     String?
  adminNote       String?
  accountName     String?
  customName      String?
  /// User-facing memo copied onto the subscription at provision
  note            String?
  quantity        Int           @default(1)
  /// Max simultaneous IPs/devices (0 = unlimited)
  limitIp         Int           @default(0)
  /// Resolved panel for this purchase (category routing)
  panelServerId   String?
  targetSubId     String?
  discountCodeId  String?
  /// Tomans removed by discount (0 if none)
  discountAmount  Int           @default(0)
  /// Price before discount; null if no discount applied
  priceBeforeDiscount Int?
  /// When true, order is omitted from sales totals (e.g. admin deleted the account)
  excludedFromSales Boolean @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id])
  plan            Plan?         @relation(fields: [planId], references: [id])
  panelServer     PanelServer?  @relation(fields: [panelServerId], references: [id])
  discountCode    DiscountCode? @relation(fields: [discountCodeId], references: [id])
  subscription    Subscription?
  targetSub       Subscription? @relation("OrderTargetSub", fields: [targetSubId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
}

model Subscription {
  id              String             @id @default(cuid())
  tenantId        String
  code            String
  userId          String
  orderId         String?            @unique
  panelServerId   String?
  title           String?
  email           String
  clientUuid      String?
  panelSubId      String?
  trafficGb       Float?
  /// When true, panel expiry is "start after first connect" (negative ms)
  startsOnConnect Boolean            @default(true)
  activatedAt     DateTime?
  /// Free test account (1 day / 250MB)
  isTest          Boolean            @default(false)
  expiresAt       DateTime
  subUrl          String?
  /// User-facing memo / note for this service
  note            String?
  /// Max simultaneous IPs/devices (0 = unlimited); mirrored from panel limitIp
  limitIp         Int                @default(0)
  /// Created without 3x-ui — admin pasted sub URL (serverless mode)
  serverless      Boolean            @default(false)
  /// Last known raw 3x-ui expiryTime (ms). Negative = duration until first connect; positive = absolute.
  panelExpiryTime BigInt?
  status          SubscriptionStatus @default(active)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id])
  order           Order?             @relation(fields: [orderId], references: [id])
  panelServer     PanelServer?       @relation(fields: [panelServerId], references: [id])
  renewOrders     Order[]            @relation("OrderTargetSub")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, email])
}

model PartnerRequest {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String   @unique
  fullName  String
  phone     String?
  note      String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

/// Partner/reseller asked to change display name + panel group (needs admin approval)
model AgentRenameRequest {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  oldName   String
  oldGroup  String
  newName   String
  newGroup  String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId, status])
  @@index([status])
}

model Setting {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     String
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

/// Promo codes: creator-scoped by default; admin codes are global within tenant; shareable = customer-facing.
model DiscountCode {
  id              String    @id @default(cuid())
  tenantId        String
  /// Normalized uppercase alphanumeric code
  code            String
  percentOff      Int
  createdByUserId String
  active          Boolean   @default(true)
  /// When true, non-admin codes may be used by any buyer (not only the creator)
  shareable       Boolean   @default(false)
  /// null = unlimited
  maxUses         Int?
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy       User      @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  orders          Order[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([createdByUserId])
  @@index([active])
}

/// Snapshot of a deleted (or archived) panel account for restore / audit detail
model AccountArchive {
  id              String    @id @default(cuid())
  tenantId        String
  email           String
  /// Full JSON payload (panel + bot fields)
  payload         String
  reason          String    @default("deleted")
  actorTelegramId BigInt?
  panelServerId   String?
  restoredAt      DateTime?
  createdAt       DateTime  @default(now())
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@index([createdAt])
  @@index([reason])
}

/// Dedupe log so expiry/traffic alerts are not spammed every cron tick
model NotificationLog {
  id             String   @id @default(cuid())
  subscriptionId String
  kind           String
  bucket         String
  createdAt      DateTime @default(now())

  @@unique([subscriptionId, kind, bucket])
  @@index([subscriptionId])
}

/// Simple audit trail for admin debugging
model AuditLog {
  id               String   @id @default(cuid())
  tenantId         String?
  action           String
  actorTelegramId  BigInt?
  target           String?
  detail           String?
  createdAt        DateTime @default(now())
  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
  @@index([action])
}

/// Temporary buy wizard state per telegram user (per tenant)
model BuyDraft {
  id          String   @id @default(cuid())
  tenantId    String
  telegramId  BigInt
  trafficGb   Int?     @default(10)
  months      Int      @default(1)
  unlimited   Boolean  @default(false)
  quantity    Int      @default(1)
  /// Max IPs for new purchase (0 = unlimited)
  limitIp         Int      @default(0)
  /// User explicitly changed IP limit in wizard (0 then means unlimited)
  limitIpTouched  Boolean  @default(false)
  category    String   @default("data")
  accountMode String   @default("random")
  accountName String?
  /// Optional discount code (normalized uppercase) for checkout
  discountCode String?
  /// Locked offer / matrix cell id when user picks a specific plan card
  priceCellId  String?
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, telegramId])
  @@index([tenantId])
}
